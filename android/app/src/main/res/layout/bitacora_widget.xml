<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- Lado Izquierdo: Info del Vehículo -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:paddingRight="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehículo: Renault Sandero"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_odometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odometer: 45,200 km"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/widget_health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salud General: 95%"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Línea divisoria vertical usando FrameLayout (soportado por RemoteViews) -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Lado Derecho: Accesos Rápidos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="8dp">

        <!-- Botón Iniciar Monitoreo -->
        <LinearLayout
            android:id="@+id/widget_btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFF"
                android:layout_marginRight="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Viaje"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Botón Tanqueo rápido (Separado por margen superior en el propio contenedor) -->
        <LinearLayout
            android:id="@+id/widget_btn_refuel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_amber_background"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ + Tanqueo"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
